>  	drm_fb_helper_unregister_fbi(&gfbdev->helper);
>  
>  	if (gfb->obj) {
> -		drm_gem_object_unreference_unlocked(gfb->obj);
> +		drm_gem_object_put_unlocked(gfb->obj);
>  		gfb->obj = NULL;
>  	}
>  
